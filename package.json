{
  "name": "agent-ops-sample",
  "version": "0.1.0",
  "private": true,
  "description": "Small reference build: a support agent that hands over to a person when unsure, answers from documents with sources, books by a voice-style call flow, with roles, monitoring and an MCP server. Sample data only.",
  "scripts": {
    "dev": "node init && next dev -p 3200",
    "build": "node init && next build",
    "start": "node init && next start -p 3200",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "next": "16.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "tsx": "4.19.2",
    "typescript": "5.5.3",
    "vitest": "2.1.4"
  }
}
